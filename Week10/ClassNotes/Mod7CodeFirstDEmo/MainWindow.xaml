<Window x:Class="Mod7CodeFirstDEmo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mod7CodeFirstDEmo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="empGrid" Grid.Column="0" Margin="5" AutoGenerateColumns="True"/>
        
       
        
        <!-- Form-->
        <StackPanel Grid.Column="1">
            <Label Content="Employee Id"/>
            <TextBox x:Name="txtId" />
            <Label Content="Employee Name"/>
            <TextBox x:Name="txtName" />
            <Label Content="Employee Salary"/>
            <TextBox x:Name="txSalary" />
            <Label Content="Department"/>
            <ComboBox x:Name="comboDept"/>

            <WrapPanel Margin="0,20,0,0">
                <Button x:Name="btnAddNew"
                        Width="90"
                        Margin="5"
                        Content="Add New"
                        Click="btnAddNew_Click"/>
                <Button x:Name="btnSubmit"
                         Width="90"
                         Margin="5"
                         Content="Submit"
                         Click="btnSubmit_Click"/>
                <Button x:Name="btnSelect"
                         Width="90"
                         Margin="5"
                         Content="Select to update"
                         Click="btnSelect_Click"/>
                <Button x:Name="btnDelete"
                         Width="90"
                         Margin="5"
                         Content="Delete"
                         Click="btnDelete_Click"/>
                <Button x:Name="btnUpdate"
                         Width="90"
                         Margin="5"
                         Content="Update"
                         Click="btnUpdate_Click"/>
            </WrapPanel>
        </StackPanel>

    </Grid>
</Window>

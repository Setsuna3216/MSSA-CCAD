<Window x:Class="Mod7ProductDBApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mod7ProductDBApp"
        mc:Ignorable="d"
        Title="Product Inventory" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" HorizontalAlignment="Center" Content="Product Inventory" FontSize="20"
               FontFamily="Book Antiqua" Foreground="BlueViolet" VerticalAlignment="Center"
               BorderBrush="Orange" BorderThickness="2"/>
        <DataGrid x:Name="ProductGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="5" BorderBrush="Orange"
                  BorderThickness="3" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header=" Product Id" Binding="{Binding ProductId}"/>
                <DataGridTextColumn Header="Product Name" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}"/>
                <DataGridTemplateColumn Header="Update Product">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Edit" Click="EditProduct"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Delete Product">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Click="DeleteProduct"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>
            </DataGrid.Columns>
            
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="Violet" BorderThickness="2" Margin="3">
                <StackPanel Margin="3">
                    <Label Content="Add Product" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid Margin="5" x:Name="AddProductGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Product Name"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="Decription"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description}"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="Price"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Price}"/>
                        <Label Grid.Row="3" Grid.Column="0" Content="Quantity"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Quantity}"/>
                        <Button Grid.Row="4" x:Name="btnAdd" Grid.ColumnSpan="2" Content="Add" Width="80" Click="btnAdd_Click"/>


                    </Grid>


                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="Violet" BorderThickness="2" Margin="3">
                <StackPanel Margin="3">
                    <Label Content="Update Product" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid Margin="5" x:Name="UpdateProductGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Product Name"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="Decription"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description}"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="Price"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Price}"/>
                        <Label Grid.Row="3" Grid.Column="0" Content="Quantity"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Quantity}"/>
                        <Button Grid.Row="4" x:Name="btnUpdate" Grid.ColumnSpan="2" Content="Update" Width="80" Click="btnUpdate_Click"/>


                    </Grid>


                </StackPanel>
            </Border>
        </Grid>
    
    </Grid>
</Window>

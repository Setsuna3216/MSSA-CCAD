<Window x:Class="Assignment_10._3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment_10._3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
            Orientation="Vertical"
            Margin="10">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="VIN:"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>       
                <TextBox x:Name="VinTextBox"
                    Width="150"/>

                <TextBlock Text="Make:"
                    VerticalAlignment="Center"
                    Margin="15,0,5,0"/>
                <TextBox x:Name="MakeTextBox"
                    Width="120"/>
                
                <TextBlock Text="Model:"
                    VerticalAlignment="Center"
                    Margin="15,0,5,0"/>
                <TextBox x:Name="ModelTextBox"  
                    Width="120"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Year:"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>

                <TextBox x:Name="YearTextBox"
                    Width="80"/>
                <TextBlock Text="Price:"
                    VerticalAlignment="Center"
                    Margin="15,0,5,0"/>
                <TextBox x:Name="PriceTextBox"
                    Width="80"/>

                <Button x:Name="AddButton"
                    Content="Add Car"
                    Width="100"
                    Margin="15,0,0,0" Click="AddButton_Click"/>
                <Button x:Name="UpdateButton"
                    Content="Update Car"
                    Width="100"
                    Margin="10,0,0,0" Click="UpdateButton_Click"/>
                <Button x:Name="DeleteButton"
                    Content="Delete Car"
                    Width="100"
                    Margin="10,0,0,0"
                    Click="DeleteButton_Click"/>
                
            </StackPanel>

        </StackPanel>

        <DataGrid x:Name="CarsGrid"
              Grid.Row="1"
              AutoGenerateColumns="True"
              Margin="10"
              IsReadOnly="True"
              SelectionChanged="CarsGrid_SelectionChanged"
                  />
        
    </Grid>

</Window>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonkeyFinder.DetailsPage"
             xmlns:viewmodel="clr-namespace:MonkeyFinder.ViewModels"
             x:DataType="viewmodel:DetailsViewModel"
             Title="{Binding Title}">
    <ScrollView>
    <VerticalStackLayout>
            <Label Text="{Binding Monkey.Details}"/>
            <Image Source="{Binding Monkey.Image}" Aspect="AspectFill" WidthRequest="150"
                   HeightRequest="150" VerticalOptions="Center"/>
            <Label Text="{Binding Monkey.Location}"/>
            <Label Text="{Binding Monkey.Population}"/>
            <Button Text="Show on map" Command="{Binding OpenMapCommand}" HorizontalOptions="Center"
                WidthRequest="100" Margin="10"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>